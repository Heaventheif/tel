# Telegram / Render
TELEGRAM_TOKEN=
SERVER_URL=https://your-service.onrender.com
PORT=10000
WEBHOOK_PATH=/webhook
# اختياري لكنه موصى به: قيمة عشوائية لحماية Webhook تيليجرام فقط.
# لا يغيّر كون /api/* مفتوحة بلا مصادقة.
TELEGRAM_WEBHOOK_SECRET=

# موارد البوت والملفات
MAX_CONCURRENT_DOWNLOADS=2
UPLOAD_LIMIT_MB=50
TEMP_DIR=/tmp
PENDING_TTL_MIN=30
SEARCH_PENDING_TTL_MIN=15
RATE_LIMIT_SECONDS=3
MAX_CLIP_DURATION_SECONDS=600
ADMIN_CHAT_IDS=

# التخزين المؤقت
CACHE_DB_PATH=media_cache.sqlite
REDIS_URL=
CACHE_TTL_DAYS=30
CACHE_HASH_LEN=12
CACHE_ENABLED=true

# مزودات الوسائط
YT_API_1=https://ccproject.serv00.net/ytdl2.php
YT_API_2=https://yt-dlp-stream.onrender.com/api
# ترتيب بدائل YouTube: YouTube.js أولاً وvreden احتياط أخير. يمكن إعادة الترتيب بلا تعديل كود.
YOUTUBE_PROVIDER_ORDER=youtubei,ccproject,yt2,vreden
FB_DOWNLOAD_API=https://betadash-api-swordslush-production.up.railway.app
FB_DOWNLOAD_API_OLD=https://facebook-video-download-api.onrender.com
FERDEV_API_KEY=
LYRICS_API=https://api.lyrics.ovh/v1
GROQ_API_KEY=
AUDD_API_KEY=

# مراقبة الخدمة
KEEP_ALIVE_INTERVAL_MIN=10
LOG_LEVEL=INFO
# text افتراضي مقروء، وjson يسهل البحث والتحليل في سجلات Render.
LOG_FORMAT=text

# REST API عامة: لا تستخدم API_KEY ولا Authorization.
# اضبط هذه القيم لتوازن بين الاستخدام العام وموارد خطة Render لديك.
API_PROBE_TIMEOUT_MS=25000
API_DOWNLOAD_TIMEOUT_MS=120000
API_BODY_LIMIT_BYTES=16384
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_PROBE=20
API_RATE_LIMIT_DOWNLOAD=5
API_CORS_ORIGINS=*
# اجعلها false فقط عندما لا تكون الاستضافة خلف proxy موثوق يضبط X-Forwarded-For.
TRUST_PROXY_HEADERS=true
